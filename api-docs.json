  "info": {
    "title": "ElderCare CRM API",
    "description": "API documentation for the CRM Platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@paramantra.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "john@paramantra.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "organizationId": {
            "type": "string",
            "description": "Organization ID if registering for a tenant"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UpdateOrgDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Paramantra Enterprise"
          },
          "gstNumber": {
            "type": "string",
            "example": "29ABCDE1234F1Z5"
          },
          "address": {
            "type": "string",
            "example": "100 Innovation Way"
          },
          "city": {
            "type": "string",
            "example": "Bangalore"
          },
          "country": {
            "type": "string",
            "example": "India"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "businessHours": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateBranchDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "North Branch"
          },
          "address": {
            "type": "string",
            "example": "123 Avenue Road"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Agent Smith"
          },
          "department": {
            "type": "string",
            "example": "Customer Support"
          },
          "extension": {
            "type": "string",
            "example": "102"
          },
          "reportingManagerId": {
            "type": "string",
            "example": "fc75cbca-5a45-46e9-9905-521d708e5ebe"
          },
          "designation": {
            "type": "string",
            "example": "SUPPORT_LEAD"
          }
        }
      },
      "AssignRoleDto": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "example": "fc75cbca-5a45-46e9-9905-521d708e5ebe"
          }
        },
        "required": [
          "roleId"
        ]
      },
      "UserStatusDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "isActive"
        ]
      },
      "CreateLeadDto": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "example": "Bruce Wayne"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+15551234567"
          },
          "email": {
            "type": "string",
            "example": "bruce@wayne.com"
          },
          "serviceInterest": {
            "type": "string",
            "example": "Elderly Care Services"
          },
          "city": {
            "type": "string",
            "example": "Gotham"
          },
          "notes": {
            "type": "string",
            "example": "Needs weekend assistance"
          },
          "source": {
            "type": "string",
            "example": "Google Ads"
          }
        },
        "required": [
          "customerName",
          "phoneNumber"
        ]
      },
      "LeadStatusUpdateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "CONVERTED"
          },
          "notes": {
            "type": "string",
            "example": "Customer called back and agreed to plan"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateLeadNoteDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "Customer called back and agreed to plan"
          },
          "callId": {
            "type": "string",
            "example": "uuid"
          }
        },
        "required": [
          "content"
        ]
      },
      "CreateActivityDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "CALL",
              "MEETING",
              "EMAIL",
              "TASK",
              "WHATSAPP",
              "SITE_VISIT"
            ],
            "example": "CALL"
          },
          "subject": {
            "type": "string",
            "example": "Discussed premium pricing options"
          },
          "description": {
            "type": "string",
            "example": "Customer called to request a price quotation"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-05-21T10:00:00Z"
          },
          "status": {
            "type": "string",
            "example": "PENDING"
          },
          "customerId": {
            "type": "string",
            "description": "Linked Customer ID"
          },
          "leadId": {
            "type": "string",
            "description": "Linked Lead ID"
          }
        },
        "required": [
          "type",
          "subject"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "Supervisor feedback: Pricing approved."
          }
        },
        "required": [
          "content"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Discuss service plan options"
          },
          "startTime": {
            "type": "string",
            "example": "2026-05-21T10:00:00Z"
          },
          "endTime": {
            "type": "string",
            "example": "2026-05-21T11:00:00Z"
          },
          "customerId": {
            "type": "string",
            "example": "fc75cbca-5a45-46e9-9905-521d708e5ebe",
            "description": "Linked Customer ID"
          },
          "status": {
            "type": "string",
            "example": "SCHEDULED"
          },
          "type": {
            "type": "string",
            "example": "MEETING"
          },
          "externalSync": {
            "type": "boolean",
            "description": "Outlook/Google calendar sync status"
          }
        },
        "required": [
          "title",
          "startTime",
          "endTime",
          "customerId"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Discuss service plan options"
          },
          "startTime": {
            "type": "string",
            "example": "2026-05-21T10:00:00Z"
          },
          "endTime": {
            "type": "string",
            "example": "2026-05-21T11:00:00Z"
          },
          "customerId": {
            "type": "string",
            "example": "fc75cbca-5a45-46e9-9905-521d708e5ebe",
            "description": "Linked Customer ID"
          },
          "status": {
            "type": "string",
            "example": "SCHEDULED"
          },
          "type": {
            "type": "string",
            "example": "MEETING"
          },
          "externalSync": {
            "type": "boolean",
            "description": "Outlook/Google calendar sync status"
          }
        },
        "required": [
          "title",
          "startTime",
          "endTime",
          "customerId"
        ]
      }
    }
  }
}